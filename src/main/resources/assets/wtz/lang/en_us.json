  "text.autoconfig.wtz-config.option.mountHelperLabelScale.tooltip": "Changes the size of Mount Helper labels.",
  "text.autoconfig.wtz-config.option.mountHelperHideMaxed.tooltip": "Hides powerups whose tracked stat is already maxed on your current mount. When every nearby powerup is maxed, they reappear after the timeout below.",
  "text.autoconfig.wtz-config.option.mountHelperMaxedTimeout.tooltip": "How long all powerups must remain maxed before they reappear as dimmed labels.",
  "text.autoconfig.wtz-config.option.mountStatsEnabled.tooltip": "Shows an overlay with stats for your current mount.",
