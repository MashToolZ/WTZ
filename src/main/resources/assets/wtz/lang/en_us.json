  "text.autoconfig.wtz-config.option.mountHelperEnabled.tooltip": "Highlights nearby mount powerups with name labels.",
  "text.autoconfig.wtz-config.option.mountHelperLabelScale.tooltip": "Changes the size of Mount Helper labels.",
  "text.autoconfig.wtz-config.option.mountHelperHideMaxed.tooltip": "Dims or hides powerups whose tracked stat is already maxed on your current mount.",
  "text.autoconfig.wtz-config.option.mountHelperMaxedTimeout.tooltip": "Set to 0 to always show maxed powerups as dimmed labels. Set above 0 to hide maxed powerups first, then show them dimmed after every nearby powerup has been maxed for this many seconds.",
  "text.autoconfig.wtz-config.option.mountHelperMaxedOpacity.tooltip": "Opacity used for dimmed maxed powerup labels.",
  "text.autoconfig.wtz-config.option.mountStatsEnabled.tooltip": "Shows an overlay with stats for your current mount.",
  "text.autoconfig.wtz-config.option.mountStatsAutoUpdate.tooltip": "Opens and closes your inventory on powerup pickup to update mount item stats.",
  "text.autoconfig.wtz-config.option.mountStatsTrackHeld.tooltip": "Reads mount stats from the mount item you are holding.",
  "text.autoconfig.wtz-config.option.mountStatsShowWhenNotMounted.tooltip": "Keeps the mount stats overlay visible even when you are not mounted.",
  "text.autoconfig.wtz-config.option.mountStatsBgOpacity.tooltip": "Controls how transparent the mount stats overlay background is.",
  "text.autoconfig.wtz-config.option.mountJumpOverlayEnabled.tooltip": "Shows a movable jump-charge bar while charging a mount jump.",
  "text.autoconfig.wtz-config.option.mountJumpAlwaysShow.tooltip": "Keeps the jump-charge bar visible while mounted, even when the current jump charge is zero.",
  "text.autoconfig.wtz-config.option.mountEnergyOverlayEnabled.tooltip": "Shows a movable custom mount energy bar using Wynncraft's tracked mount energy state.",
  "text.autoconfig.wtz-config.option.mountEnergyHideVanilla.tooltip": "Hides Wynncraft's vanilla mount energy actionbar while the custom energy bar is active.",
  "text.autoconfig.wtz-config.option.mountItemOverlayEnabled.tooltip": "Shows extra mount information directly on mount items.",
  "text.autoconfig.wtz-config.option.mountItemOverlayPotentialEnabled.tooltip": "Adds the calculated mount potential to mount item overlays.",
  "text.autoconfig.wtz-config.option.mountItemOverlayBarsEnabled.tooltip": "Shows stat bars on mount item overlays.",
  "text.autoconfig.wtz-config.option.mountItemOverlayBarsModifierKey.tooltip": "Requires the selected modifier key to show stat bars in inventory screens. None shows them at all times.",
  "text.autoconfig.wtz-config.option.mountItemOverlayBarsAlwaysShowInHotbar.tooltip": "Shows mount stat bars on hotbar items even when inventory stat bars require a modifier key.",
  "text.autoconfig.wtz-config.option.mountItemOverlaySkinColorsEnabled.tooltip": "Displays the mount skin name above the item in the purchase window.",
  "text.autoconfig.wtz-config.option.mountItemOverlayHorseInitialsEnabled.tooltip": "Always show color initials on every visible Horse item slot (inventory, chest, and hotbar).",
