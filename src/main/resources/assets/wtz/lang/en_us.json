  "text.autoconfig.wtz-config.option.mountStatsTrackHeld.tooltip": "Reads mount stats from the mount item you are holding.",
  "text.autoconfig.wtz-config.option.mountStatsShowWhenNotMounted.tooltip": "Keeps the mount stats overlay visible even when you are not mounted.",
  "text.autoconfig.wtz-config.option.mountStatsAnchor.tooltip": "Chooses which part of the screen the mount stats overlay is positioned from.",
  "text.autoconfig.wtz-config.option.mountStatsOffsetX.tooltip": "Moves the mount stats overlay left or right from its anchor.",
  "text.autoconfig.wtz-config.option.mountStatsOffsetY.tooltip": "Moves the mount stats overlay up or down from its anchor.",
  "text.autoconfig.wtz-config.option.mountStatsScale.tooltip": "Changes the size of the mount stats overlay.",
  "text.autoconfig.wtz-config.option.mountItemOverlayEnabled.tooltip": "Shows extra mount information directly on mount items.",
  "text.autoconfig.wtz-config.option.mountItemOverlayPotentialEnabled.tooltip": "Adds the calculated mount potential to mount item overlays.",
  "text.autoconfig.wtz-config.option.mountItemOverlayBarsEnabled.tooltip": "Shows stat bars on mount item overlays.",
  "text.autoconfig.wtz-config.option.mountSkinReportingEnabled.tooltip": "Allows WTZ to submit discovered mount skin data when your account is linked with an API key.",
  "text.autoconfig.wtz-config.option.qualityOfLifeEnabled.tooltip": "Master toggle for WynnToolZ quality-of-life helpers.",
  "text.autoconfig.wtz-config.option.qolRightClickBack.tooltip": "Right-clicks the Back item in Wynncraft menus when you right-click empty space or a slot without its own right-click action.",
  "text.autoconfig.wtz-config.option.qolHideActionbarInChat.tooltip": "Hides the Wynncraft UI (NPC dialogue boxes, status messages, and other actionbar text) while chat is open.",
  "text.autoconfig.wtz-config.option.qolActionbarAboveChat.tooltip": "Moves the Wynncraft UI (NPC dialogue boxes, status messages, and other actionbar text) above the chat input while chat is open.",
  "text.autoconfig.wtz-config.option.shoppingListEnabled.tooltip": "Enables the in-game shopping list overlay.",
  "text.autoconfig.wtz-config.option.shoppingListScale.tooltip": "Changes the size of the shopping list overlay.",
  "text.autoconfig.wtz-config.option.mountCameraEnabled.tooltip": "Master toggle for the custom third-person mount camera and its sub-features.",
  "text.autoconfig.wtz-config.option.mountCameraAutoPerspective.tooltip": "Automatically switches to third-person when you mount up, and back to your previous view when you dismount.",
  "text.autoconfig.wtz-config.option.mountCameraFreeLook.tooltip": "While mounted in third-person, hold Left-Click to drag the camera around your mount without turning the player. Has no effect in first-person.",
  "text.autoconfig.wtz-config.option.mountCameraScrollZoom.tooltip": "Allows limited mouse wheel zoom while using the mount camera.",
